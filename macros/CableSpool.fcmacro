# -*- coding: utf-8 -*-
"""
CableSpool.FCMacro  -  parametric stadium-shaped cable spool for FreeCAD

Body     : stadium (rectangle + semicircle ends), extruded in Z
Side     : helical groove the cable snaps into (constant pitch)
Ends     : first/last loop continue into a ramp "corridor" that climbs to the
           bottom/top face, and there the groove keeps running round while
           tightening inward - the way the last turn of a wound cable does - so
           it ends up on the inside of the wall with no corner to kink the
           cable. Draw your USB-C connector pocket on the face where that run
           ends (markers "Anchor_Bottom" / "Anchor_Top" show where).

Output   : PartDesign Body "CableSpool" (base shape inside) -> sketch on the
           top/bottom face and Pocket your connector shape directly.

Edit the parameters below, then run the macro again (it builds a new set).
All dimensions in mm.
"""

import math
import FreeCAD as App
import Part

# ============================ PARAMETERS ============================
CABLE_LENGTH        = 1500.0  # total cable length incl. connectors
CABLE_DIAMETER      = 3.5     # MEASURE your cable with calipers
CLEARANCE           = 0.3     # added to cable diameter for the groove
GROOVE_DEPTH_FAC    = 0.85    # groove depth / groove diameter
                              #   0.5 = half-open, 0.8-0.9 = snap-in lip, <1.0 !
MIN_WALL            = 1.2     # plastic rib between neighbouring turns

WIDTH               = 40.0    # outer width  (= diameter of the round ends)
LENGTH              = 75.0    # outer length (>= WIDTH)
HEIGHT              = 0.0     # 0 = auto from cable length
                              # >0 = fixed height, pitch is adapted

END_MARGIN          = 0.0     # face -> centre of first/last turn, 0 = auto
RAMP_LENGTH         = 25.0    # length along perimeter used to climb to face
FACE_TURN           = 0.5     # after the ramp reaches the face the groove keeps
                              # running round, tightening inward - this is how
                              # many laps that takes (0 = stop at the wall)
FACE_INSET          = 0.0     # how far inward the groove moves over that run;
                              # 0 = auto (just clears the outer wall)
FACE_DEPTH          = 0.0     # depth of face channel, 0 = groove diameter
CONNECTOR_ALLOWANCE = 30.0    # cable+connector length (per end) that sits in
                              # the pocket YOU will draw after the face run
EDGE_FILLET         = 1.5     # top/bottom outer edge fillet, 0 = none
SLOT_EPS            = 0.05    # face slot is this much wider than the
                              # groove, to keep its walls off the tube
SAMPLE_STEP         = 3.0     # ramp sampling step (smaller = smoother, slower);
                              # the spiral itself is exact geometry

USE_DIALOG          = True    # ask for values at start (remembers last input)
# ====================================================================

V = App.Vector


def log(msg):
    App.Console.PrintMessage("[CableSpool] " + msg + "\n")


def warn(msg):
    App.Console.PrintWarning("[CableSpool] " + msg + "\n")


# ---------------------------------------------------------------- input dialog
# (key, label, min, max, decimals, step, suffix)
DIALOG_FIELDS = [
    ("CABLE_LENGTH",        "Cable length",                 100, 10000, 0, 50,  " mm"),
    ("CABLE_DIAMETER",      "Cable diameter",               1.0, 15.0,  2, 0.1, " mm"),
    ("CLEARANCE",           "Groove clearance",             0.0, 2.0,   2, 0.05, " mm"),
    ("GROOVE_DEPTH_FAC",    "Groove depth factor (0.5-0.95)", 0.5, 0.95, 2, 0.05, ""),
    ("WIDTH",               "Spool width",                  10, 300,    1, 1,   " mm"),
    ("LENGTH",              "Spool length (>= width)",      10, 500,    1, 1,   " mm"),
    ("HEIGHT",              "Spool height (0 = auto)",      0, 500,     1, 1,   " mm"),
    ("MIN_WALL",            "Wall between turns",           0.4, 10,    2, 0.1, " mm"),
    ("RAMP_LENGTH",         "Corridor ramp length",         5, 200,     1, 1,   " mm"),
    ("FACE_TURN",           "Face run (laps round the face)", 0, 2.0,  2, 0.05, ""),
    ("FACE_INSET",          "Face run inset (0 = auto)",    0, 100,    1, 0.5, " mm"),
    ("CONNECTOR_ALLOWANCE", "Cable+connector in pocket (per end)", 0, 200, 1, 1, " mm"),
]

# which of the three schematics explains which parameter
DIAGRAM_VIEW = {
    "CABLE_DIAMETER": "section", "CLEARANCE": "section",
    "GROOVE_DEPTH_FAC": "section", "MIN_WALL": "section",
    "WIDTH": "plan", "LENGTH": "plan", "RAMP_LENGTH": "plan",
    "FACE_TURN": "plan", "FACE_INSET": "plan",
    "CONNECTOR_ALLOWANCE": "plan",
    "CABLE_LENGTH": "side", "HEIGHT": "side",
}


class Cancelled(Exception):
    pass


def qt_modules():
    try:
        from PySide6 import QtWidgets, QtGui, QtCore
    except ImportError:
        try:
            from PySide2 import QtWidgets, QtGui, QtCore
        except ImportError:
            from PySide import QtGui, QtCore
            QtWidgets = QtGui
    return QtWidgets, QtGui, QtCore


def qt_enum(owner, name, scope):
    """PySide6 nests enums in a scope class, older bindings expose them flat"""
    v = getattr(owner, name, None)
    if v is None:
        v = getattr(getattr(owner, scope), name)
    return v


def preview_geometry(v):
    """The macro's own derivation, run on whatever is in the dialog right now,
    so the diagrams and the computed line show what you are about to build.
    Returns None while the numbers are still inconsistent."""
    try:
        d = v["CABLE_DIAMETER"] + v["CLEARANCE"]
        R = d / 2.0
        depth = v["GROOVE_DEPTH_FAC"] * d
        r = v["WIDTH"] / 2.0 - depth + R
        S = max(0.0, (v["LENGTH"] - v["WIDTH"]) / 2.0)
        P = 4.0 * S + 2.0 * math.pi * r
        if r <= R or P <= 0.0:
            return None
        face_depth = FACE_DEPTH if FACE_DEPTH > 0 else d
        zb = face_depth - R
        z0 = END_MARGIN if END_MARGIN > 0 else face_depth + v["MIN_WALL"] + R
        pitch = d + v["MIN_WALL"]
        inset = (v["FACE_INSET"] if v["FACE_INSET"] > 0
                 else (d - depth) + v["MIN_WALL"] + R)
        face_len = v["FACE_TURN"] * P          # close enough for the preview
        per_end = (math.hypot(v["RAMP_LENGTH"], z0 - zb)
                   + face_len + v["CONNECTOR_ALLOWANCE"])
        if v["HEIGHT"] > 0:
            H = v["HEIGHT"]
            turns = max(0.0, (H - 2.0 * z0) / pitch)
        else:
            turns = max(0.0, (v["CABLE_LENGTH"] - 2.0 * per_end)
                        / math.hypot(P, pitch))
            H = 2.0 * z0 + pitch * turns
        return dict(d=d, R=R, depth=depth, r=r, S=S, P=P, pitch=pitch,
                    z0=z0, zb=zb, turns=turns, H=H, per_end=per_end,
                    inset=inset, face_len=face_len,
                    open_w=2.0 * math.sqrt(max(R * R - (depth - R) ** 2, 0.0)))
    except Exception:
        return None


def ask_values():
    QtWidgets, QtGui, QtCore = qt_modules()
    import FreeCADGui

    Qt = QtCore.Qt
    AA = qt_enum(QtGui.QPainter, "Antialiasing", "RenderHint")
    ALIGN_C = qt_enum(Qt, "AlignCenter", "AlignmentFlag")
    DASH = qt_enum(Qt, "DashLine", "PenStyle")
    NO_PEN = qt_enum(Qt, "NoPen", "PenStyle")
    NO_BRUSH = qt_enum(Qt, "NoBrush", "BrushStyle")
    FOCUS_IN = qt_enum(QtCore.QEvent, "FocusIn", "Type")
    ROUND_CAP = qt_enum(Qt, "RoundCap", "PenCapStyle")
    PT = QtCore.QPointF

    class Diagram(QtWidgets.QWidget):
        """Schematic of the parameter under the cursor, drawn to scale from the
        values currently in the dialog."""

        def __init__(self, values, parent=None):
            QtWidgets.QWidget.__init__(self, parent)
            self.values = values
            self.key = "WIDTH"
            self.setMinimumSize(430, 330)

        def set_key(self, key):
            if key != self.key:
                self.key = key
                self.update()

        # ---- painting helpers ----
        def _colours(self):
            pal = self.palette()
            ink = pal.color(qt_enum(QtGui.QPalette, "WindowText", "ColorRole"))
            hot = QtGui.QColor(226, 78, 42)
            if ink.lightness() < 128:          # light theme
                hot = QtGui.QColor(198, 52, 20)
            faint = QtGui.QColor(ink)
            faint.setAlpha(90)
            fill = QtGui.QColor(ink)
            fill.setAlpha(38)
            return ink, hot, faint, fill

        def _pen(self, col, w=1.4, style=None):
            p = QtGui.QPen(col)
            p.setWidthF(w)
            p.setCapStyle(ROUND_CAP)
            if style is not None:
                p.setStyle(style)
            return p

        def _text(self, p, x, y, s, col):
            f = p.font()
            f.setPointSizeF(max(7.0, self.font().pointSizeF() * 0.82))
            p.setFont(f)
            fm = QtGui.QFontMetricsF(f)
            w = (fm.horizontalAdvance(s) if hasattr(fm, "horizontalAdvance")
                 else fm.width(s))
            h = fm.height()
            bg = QtGui.QColor(self.palette().color(
                qt_enum(QtGui.QPalette, "Window", "ColorRole")))
            bg.setAlpha(205)
            rect = QtCore.QRectF(x - w / 2.0 - 2, y - h / 2.0, w + 4, h)
            p.setPen(NO_PEN)
            p.setBrush(bg)
            p.drawRect(rect)
            p.setBrush(NO_BRUSH)
            p.setPen(col)
            p.drawText(rect, ALIGN_C, s)

        def _arrow(self, p, tip, frm, size=5.0):
            dx, dy = tip.x() - frm.x(), tip.y() - frm.y()
            L = math.hypot(dx, dy)
            if L < 1e-6:
                return
            ux, uy = dx / L, dy / L
            for s in (1.0, -1.0):
                p.drawLine(tip, PT(tip.x() - ux * size - s * uy * size * 0.45,
                                   tip.y() - uy * size + s * ux * size * 0.45))

        def _dim(self, p, a, b, label, hot, off=12.0):
            """arrowed dimension line a->b, label offset perpendicular"""
            ink, hotc, faint, _ = self._colours()
            col = hotc if hot else faint
            dx, dy = b.x() - a.x(), b.y() - a.y()
            L = math.hypot(dx, dy)
            if L < 1e-6:
                return
            nx, ny = -dy / L, dx / L
            a2 = PT(a.x() + nx * off, a.y() + ny * off)
            b2 = PT(b.x() + nx * off, b.y() + ny * off)
            p.setPen(self._pen(col, 1.6 if hot else 1.0))
            p.drawLine(a2, b2)
            p.drawLine(a, a2)
            p.drawLine(b, b2)
            self._arrow(p, a2, b2)
            self._arrow(p, b2, a2)
            self._text(p, (a2.x() + b2.x()) / 2.0 + nx * 9,
                       (a2.y() + b2.y()) / 2.0 + ny * 9, label, col)

        # ---- the three schematics ----
        def paintEvent(self, ev):
            p = QtGui.QPainter(self)
            try:
                p.setRenderHint(AA, True)
                geo = preview_geometry(self.values())
                view = DIAGRAM_VIEW.get(self.key, "plan")
                box = QtCore.QRectF(10, 8, self.width() - 20,
                                    self.height() - 44)
                if geo is None:
                    self._text(p, self.width() / 2.0, self.height() / 2.0,
                               "check the values", self._colours()[1])
                    return
                if view == "section":
                    self._section(p, box, geo)
                elif view == "plan":
                    self._plan(p, box, geo)
                else:
                    self._side(p, box, geo)
                ink, hot, faint, _ = self._colours()
                self._text(p, self.width() / 2.0, self.height() - 14,
                           u"⌀%.2f groove · pitch %.2f · "
                           u"%.1f turns · height %.1f mm"
                           % (geo["d"], geo["pitch"], geo["turns"], geo["H"]),
                           ink)
            except Exception:
                pass
            finally:
                p.end()

        def _section(self, p, box, g):
            """wall cross-section: three turns of the snap-in groove"""
            ink, hot, faint, fill = self._colours()
            v = self.values()
            d, R, depth, pitch = g["d"], g["R"], g["depth"], g["pitch"]
            slab = depth + 4.0                      # wall thickness we show
            sc = min(box.width() * 0.42 / slab,
                     box.height() / (2.0 * pitch + d + 3.0))
            surf = box.left() + box.width() * 0.60  # the outer surface
            x_in = surf - slab * sc                 # back of the shown slab
            cy = box.center().y()
            k = self.key

            # material with the grooves taken out -> the undercut lips are real
            mat = QtGui.QPainterPath()
            mat.addRect(QtCore.QRectF(x_in, box.top(), surf - x_in,
                                      box.height()))
            centres = []
            for i in (-1, 0, 1):
                c = PT(surf - (depth - R) * sc, cy + i * pitch * sc)
                centres.append(c)
                hole = QtGui.QPainterPath()
                hole.addEllipse(c, R * sc, R * sc)
                mat = mat.subtracted(hole)
            p.setPen(self._pen(ink, 1.6))
            p.setBrush(fill)
            p.drawPath(mat)
            p.setBrush(NO_BRUSH)

            # the cable itself, so the clearance is visible as the gap
            cable = v["CABLE_DIAMETER"] / 2.0 * sc
            p.setPen(self._pen(hot if k in ("CABLE_DIAMETER", "CLEARANCE")
                               else faint, 1.3, DASH))
            p.drawEllipse(centres[1], cable, cable)

            # groove diameter, straight across the middle groove
            self._dim(p, PT(centres[1].x() - R * sc, centres[1].y()),
                      PT(centres[1].x() + R * sc, centres[1].y()),
                      u"\u2300 %.2f" % d,
                      k in ("CABLE_DIAMETER", "CLEARANCE"), off=0.0)
            if k == "CLEARANCE":
                self._text(p, centres[1].x(), centres[1].y() + cable + 11,
                           "cable %.2f + %.2f clearance"
                           % (v["CABLE_DIAMETER"], v["CLEARANCE"]), hot)

            # depth: surface -> bottom of the groove, at the groove's own height
            self._dim(p, PT(surf, centres[0].y()),
                      PT(centres[0].x() - R * sc, centres[0].y()),
                      "depth %.2f" % depth, k == "GROOVE_DEPTH_FAC", off=16.0)

            # pitch on the inside, wall thickness out in the open air
            self._dim(p, centres[0], centres[1], "pitch %.2f" % pitch,
                      k == "MIN_WALL",
                      off=(centres[0].x() - x_in) + 24.0)
            self._dim(p, PT(centres[1].x(), centres[1].y() + R * sc),
                      PT(centres[2].x(), centres[2].y() - R * sc),
                      "wall %.2f" % (pitch - d), k == "MIN_WALL",
                      off=-((surf - centres[1].x()) + 30.0))

            # how wide the groove actually opens at the surface
            half = math.sqrt(max(R * R - (depth - R) ** 2, 0.0)) * sc
            lip = k == "GROOVE_DEPTH_FAC"
            p.setPen(self._pen(hot if lip else faint, 3.0))
            p.drawLine(PT(surf, centres[2].y() - half),
                       PT(surf, centres[2].y() + half))
            self._text(p, surf + 46, centres[2].y(),
                       "opening %.2f" % g["open_w"], hot if lip else faint)
            self._text(p, (x_in + surf) / 2.0, box.top() + 9, "wall", faint)
            self._text(p, surf + 40, box.bottom() - 8, "outside", faint)

        def _plan(self, p, box, g):
            """top view: outline, and the ramp -> bend -> channel end detail"""
            ink, hot, faint, fill = self._colours()
            v = self.values()
            hw, S, r = v["WIDTH"] / 2.0, g["S"], g["r"]
            half_len = S + hw
            sc = min(box.width() / (2.0 * half_len + 26.0),
                     box.height() / (2.0 * hw + 30.0))
            cx, cy = box.center().x(), box.center().y()

            def to_px(x, y):
                return PT(cx + x * sc, cy - y * sc)

            body = QtGui.QPainterPath()
            body.addRoundedRect(
                QtCore.QRectF(cx - half_len * sc, cy - hw * sc,
                              2.0 * half_len * sc, 2.0 * hw * sc),
                hw * sc, hw * sc)
            p.setPen(self._pen(ink, 1.6))
            p.setBrush(fill)
            p.drawPath(body)
            p.setBrush(NO_BRUSH)

            P = g["P"]

            def to_inward(x, y):
                vx, vy = max(-S, min(S, x)) - x, -y
                n = math.hypot(vx, vy) or 1.0
                return vx / n, vy / n

            def stad(u):
                """centre-line point + unit tangent, same parametrisation as
                the macro's stadium_xy"""
                u = u % P
                if u < S:
                    return u, -r, 1.0, 0.0
                u -= S
                if u < math.pi * r:
                    t = -math.pi / 2 + u / r
                    return (S + r * math.cos(t), r * math.sin(t),
                            -math.sin(t), math.cos(t))
                u -= math.pi * r
                if u < 2 * S:
                    return S - u, r, -1.0, 0.0
                u -= 2 * S
                if u < math.pi * r:
                    t = math.pi / 2 + u / r
                    return (-S + r * math.cos(t), r * math.sin(t),
                            -math.sin(t), math.cos(t))
                return -S + (u - math.pi * r), -r, 1.0, 0.0

            # groove centre-line
            path = QtGui.QPainterPath()
            n = 160
            for i in range(n + 1):
                x, y, _, _ = stad(P * i / n)
                pt = to_px(x, y)
                path.moveTo(pt) if i == 0 else path.lineTo(pt)
            p.setPen(self._pen(faint, 1.0, DASH))
            p.drawPath(path)

            k = self.key
            ramp = v["RAMP_LENGTH"]
            # ramp run, still out on the wall
            rp = QtGui.QPainterPath()
            for i in range(41):
                x, y, _, _ = stad(-ramp + ramp * i / 40.0)
                pt = to_px(x, y)
                rp.moveTo(pt) if i == 0 else rp.lineTo(pt)
            p.setPen(self._pen(hot if k == "RAMP_LENGTH" else ink, 2.6))
            p.drawPath(rp)

            # face run: keeps going round while tightening inward, so it ends
            # up on the inside of the wall with no corner anywhere
            inset, span = g["inset"], v["FACE_TURN"] * P
            ax = ay = None
            if span > 0:
                fp = QtGui.QPainterPath()
                for i in range(61):
                    t = i / 60.0
                    x, y, _, _ = stad(-ramp - t * span)
                    nx, ny = to_inward(x, y)
                    o = inset * (t * t * (3 - 2 * t))
                    ax, ay = x + nx * o, y + ny * o
                    pt = to_px(ax, ay)
                    fp.moveTo(pt) if i == 0 else fp.lineTo(pt)
                p.setPen(self._pen(
                    hot if k in ("FACE_TURN", "FACE_INSET") else ink, 2.6))
                p.drawPath(fp)
            else:
                ax, ay, _, _ = stad(-ramp)
            p.setPen(self._pen(ink, 1.0))
            p.setBrush(hot)
            p.drawEllipse(to_px(ax, ay), 3.0, 3.0)
            p.setBrush(NO_BRUSH)
            self._text(p, to_px(ax, ay).x(), to_px(ax, ay).y() - 13,
                       "anchor", faint)
            ca_len = v["CONNECTOR_ALLOWANCE"]
            if ca_len > 0:
                nx, ny = to_inward(ax, ay)
                ex, ey = ax + nx * ca_len * 0.35, ay + ny * ca_len * 0.35
                p.setPen(self._pen(
                    hot if k == "CONNECTOR_ALLOWANCE" else faint, 1.6, DASH))
                p.drawLine(to_px(ax, ay), to_px(ex, ey))
                self._text(p, to_px(ex, ey).x(), to_px(ex, ey).y() + 12,
                           "your pocket %.0f" % ca_len,
                           hot if k == "CONNECTOR_ALLOWANCE" else faint)
            if k == "RAMP_LENGTH":
                mx, my, _, _ = stad(-ramp * 0.5)
                self._text(p, to_px(mx, my).x(), to_px(mx, my).y() - 14,
                           "ramp %.0f" % ramp, hot)
            if k in ("FACE_TURN", "FACE_INSET"):
                mx, my, _, _ = stad(-ramp - span * 0.5)
                nx, ny = to_inward(mx, my)
                o = inset * 0.5
                self._text(p, to_px(mx + nx * o, my + ny * o).x(),
                           to_px(mx + nx * o, my + ny * o).y() - 14,
                           "%.2f lap, %.1f mm in" % (v["FACE_TURN"], inset),
                           hot)
            # overall sizes
            self._dim(p, to_px(-half_len, -hw), to_px(half_len, -hw),
                      "LENGTH %.0f" % v["LENGTH"], k == "LENGTH", off=22.0)
            self._dim(p, to_px(-half_len, -hw), to_px(-half_len, hw),
                      "WIDTH %.0f" % v["WIDTH"], k == "WIDTH", off=26.0)

        def _side(self, p, box, g):
            """side view: overall height, end margins and the turn stack"""
            ink, hot, faint, fill = self._colours()
            v = self.values()
            H, z0, pitch = g["H"], g["z0"], g["pitch"]
            wide = v["LENGTH"]
            sc = min(box.width() * 0.62 / wide, box.height() / max(H, 1.0))
            w2 = wide * sc / 2.0
            cx = box.left() + box.width() * 0.42
            base = box.bottom()

            def yz(z):
                return base - z * sc

            p.setPen(self._pen(ink, 1.6))
            p.setBrush(fill)
            p.drawRoundedRect(QtCore.QRectF(cx - w2, yz(H), 2 * w2, H * sc),
                              3.0, 3.0)
            p.setBrush(NO_BRUSH)
            # the turns
            p.setPen(self._pen(faint, 1.8))
            k = self.key
            turns = int(min(g["turns"], 60))
            for i in range(turns + 1):
                z = z0 + i * pitch
                if z > H - z0 + 1e-6:
                    break
                p.drawLine(PT(cx - w2, yz(z)), PT(cx + w2, yz(z - pitch * 0.5)))
            p.setPen(self._pen(hot if k == "CABLE_LENGTH" else ink, 2.2))
            p.drawLine(PT(cx - w2, yz(z0)), PT(cx + w2, yz(z0 - pitch * 0.5)))
            self._dim(p, PT(cx + w2, yz(0)), PT(cx + w2, yz(H)),
                      "HEIGHT %.1f" % H, k == "HEIGHT", off=-26.0)
            self._dim(p, PT(cx - w2, yz(0)), PT(cx - w2, yz(z0)),
                      "margin %.1f" % z0, False, off=22.0)
            self._text(p, cx, yz(H) - 12,
                       "%.0f mm cable → %.1f turns"
                       % (v["CABLE_LENGTH"], g["turns"]),
                       hot if k == "CABLE_LENGTH" else ink)

    class FocusWatch(QtCore.QObject):
        def __init__(self, owner, keys):
            QtCore.QObject.__init__(self, owner)
            self.keys = keys
            self.diagram = None

        def eventFilter(self, obj, ev):
            if ev.type() == FOCUS_IN and self.diagram is not None:
                key = self.keys.get(obj)
                if key:
                    self.diagram.set_key(key)
            return False

    prefs = App.ParamGet("User parameter:BaseApp/Preferences/Macros/CableSpool")
    g = globals()

    dlg = QtWidgets.QDialog(FreeCADGui.getMainWindow())
    dlg.setWindowTitle("Cable Spool parameters")
    outer = QtWidgets.QHBoxLayout(dlg)
    form = QtWidgets.QFormLayout()
    outer.addLayout(form)
    boxes = {}
    by_widget = {}
    for key, label, lo, hi, dec, step, suf in DIALOG_FIELDS:
        sb = QtWidgets.QDoubleSpinBox()
        sb.setRange(lo, hi)
        sb.setDecimals(dec)
        sb.setSingleStep(step)
        sb.setSuffix(suf)
        sb.setValue(prefs.GetFloat(key, float(g[key])))
        form.addRow(label, sb)
        boxes[key] = sb
        by_widget[sb] = key

    def current():
        return dict((k, sb.value()) for k, sb in boxes.items())

    diagram = Diagram(current, dlg)
    watch = FocusWatch(dlg, by_widget)
    watch.diagram = diagram
    for key, sb in boxes.items():
        sb.installEventFilter(watch)
        sb.valueChanged.connect(
            lambda _v, k=key: (diagram.set_key(k), diagram.update()))

    right = QtWidgets.QVBoxLayout()
    hint = QtWidgets.QLabel("Click a field - the drawing shows what it means "
                            "(to scale, from the current values).")
    hint.setWordWrap(True)
    right.addWidget(hint)
    right.addWidget(diagram, 1)
    outer.addLayout(right, 1)

    bb = QtWidgets.QDialogButtonBox(
        QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel)
    bb.accepted.connect(dlg.accept)
    bb.rejected.connect(dlg.reject)
    form.addRow(bb)

    run = getattr(dlg, "exec", None) or dlg.exec_
    if not run():
        raise Cancelled("cancelled by user")
    for key, sb in boxes.items():
        g[key] = sb.value()
        prefs.SetFloat(key, sb.value())


if USE_DIALOG and App.GuiUp:
    ask_values()

# ---------------------------------------------------------------- derived
d = CABLE_DIAMETER + CLEARANCE          # groove diameter
R = d / 2.0
if not (0.5 <= GROOVE_DEPTH_FAC < 1.0):
    raise ValueError("GROOVE_DEPTH_FAC must be in [0.5, 1.0)")
if LENGTH < WIDTH:
    raise ValueError("LENGTH must be >= WIDTH")

depth = GROOVE_DEPTH_FAC * d
r = WIDTH / 2.0 - depth + R             # groove centre-line radius
S = (LENGTH - WIDTH) / 2.0              # half length of straight part
P = 4.0 * S + 2.0 * math.pi * r         # centre-line perimeter per turn
if r <= R + 2.0:
    raise ValueError("WIDTH too small for this cable")

def stadium_xy(u):
    """point + tangent on centre-line; u=0 is middle of the -Y straight side,
    running counter-clockwise (seen from top)."""
    u = u % P
    if u < S:
        return u, -r, 1.0, 0.0
    u -= S
    if u < math.pi * r:
        th = -math.pi / 2 + u / r
        return S + r * math.cos(th), r * math.sin(th), -math.sin(th), math.cos(th)
    u -= math.pi * r
    if u < 2 * S:
        return S - u, r, -1.0, 0.0
    u -= 2 * S
    if u < math.pi * r:
        th = math.pi / 2 + u / r
        return -S + r * math.cos(th), r * math.sin(th), -math.sin(th), math.cos(th)
    u -= math.pi * r
    return -S + u, -r, 1.0, 0.0


def smooth(t):
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


def inward_dir(x, y):
    cx = max(-S, min(S, x))
    vx, vy = cx - x, -y
    n = math.hypot(vx, vy)
    return vx / n, vy / n


face_depth = FACE_DEPTH if FACE_DEPTH > 0 else d
zb = face_depth - R                     # centre z of bottom face channel
z0 = END_MARGIN if END_MARGIN > 0 else face_depth + MIN_WALL + R
if z0 - zb < 0.5:
    raise ValueError("END_MARGIN too small (ramp would not climb)")
if RAMP_LENGTH > 0.8 * P:
    raise ValueError("RAMP_LENGTH too long for this perimeter")

ramp3d = math.hypot(RAMP_LENGTH, z0 - zb)
# Face run: the groove does not stop at the wall and strike out for the centre -
# it keeps going round and tightens inward, the way the last turn on a wound
# cable naturally does. That leaves it sitting on the inside of the wall, on the
# face, with no corner anywhere, and that is where the connector pocket starts.
face_inset = FACE_INSET if FACE_INSET > 0 else (d - depth) + MIN_WALL + R
face_run = FACE_TURN * P                # how far round the face run goes, in u
if face_run > 0 and r - face_inset <= R + MIN_WALL:
    raise ValueError("FACE_INSET %.1f mm is too deep for this spool "
                     "(groove centre would reach %.1f mm from the axis)"
                     % (face_inset, r - face_inset))


if FACE_TURN >= 1.0 and face_inset < FACE_TURN * (d + MIN_WALL):
    raise ValueError("FACE_TURN %.2f needs FACE_INSET >= %.1f mm, else the run "
                     "laps back over itself (now %.1f mm)"
                     % (FACE_TURN, FACE_TURN * (d + MIN_WALL), face_inset))


def face_run_length(u_start, sgn):
    """length of one face run. It only needs r, S, P and face_inset, so it can
    be measured before the height derivation that wants it for the budget."""
    if face_run <= 0:
        return 0.0
    total, prev = 0.0, None
    n = 48
    for i in range(n + 1):
        t = i / float(n)
        x, y, _, _ = stadium_xy(u_start + sgn * t * face_run)
        nx, ny = inward_dir(x, y)
        o = face_inset * smooth(t)
        cur = (x + nx * o, y + ny * o)
        if prev is not None:
            total += math.hypot(cur[0] - prev[0], cur[1] - prev[1])
        prev = cur
    return total


# the bottom run starts at a known place; the top one lands wherever the spiral
# ends, but a fixed u-span has near enough the same length wherever it starts
face_len = face_run_length(-RAMP_LENGTH, -1.0)
per_end = ramp3d + face_len + CONNECTOR_ALLOWANCE
L_spiral = CABLE_LENGTH - 2.0 * per_end
if L_spiral <= P:
    raise ValueError("Cable too short for this spool size")

if HEIGHT <= 0:
    pitch = d + MIN_WALL
    turns = L_spiral / math.hypot(P, pitch)
    H = 2.0 * z0 + pitch * turns
else:
    H = HEIGHT
    pitch = d + MIN_WALL
    for _ in range(10):  # iterate: 3D length depends on pitch
        turns = L_spiral / math.hypot(P, pitch)
        pitch = (H - 2.0 * z0) / turns
    if pitch < d + MIN_WALL:
        need = 2.0 * z0 + (d + MIN_WALL) * turns
        raise ValueError("HEIGHT too small: need >= %.1f mm "
                         "(or increase LENGTH/WIDTH)" % need)

u_end = turns * P                       # perimeter-parameter at spiral end
zt = H - zb                             # centre z of top face channel
z_end = z0 + pitch * turns
u_face_bot_end = -RAMP_LENGTH           # ramp start = end of the bottom face run
u_face_top_start = u_end + RAMP_LENGTH  # ramp end   = start of the top face run
u_face_bot = u_face_bot_end - face_run  # the two anchors, where your pocket goes
u_face_top = u_face_top_start + face_run

log("perimeter/turn %.1f  turns %.2f  pitch %.2f  height %.1f"
    % (P, turns, pitch, H))


# ---------------------------------------------------------------- geometry helpers
def z_of(u):
    if u < 0:
        return z0 - (z0 - zb) * smooth(-u / RAMP_LENGTH)
    if u <= u_end:
        return z0 + pitch * u / P
    return z_end + (zt - z_end) * smooth((u - u_end) / RAMP_LENGTH)


def off_of(u):
    """how far the centre-line has moved inward from the wall; 0 everywhere
    except the two face runs, where it eases in with the same smoothstep the
    ramps use, so the join stays tangent-continuous"""
    if face_run <= 0:
        return 0.0
    if u < u_face_bot_end:
        return face_inset * smooth((u_face_bot_end - u) / face_run)
    if u > u_face_top_start:
        return face_inset * smooth((u - u_face_top_start) / face_run)
    return 0.0


# --- exact centre-line -------------------------------------------------------
# The centre-line lies on the surface of the stadium prism, so it decomposes
# into exact geometry: the straight sides give 3D line segments, the round ends
# give true helix arcs.  Building the spine this way (instead of interpolating a
# BSpline through sampled points) is what makes the sweep work - OCC's
# BRepOffsetAPI_MakePipeShell fails with "MakeSolid" on a BSpline spine.
KNOTS = [0.0, S, S + math.pi * r, 3.0 * S + math.pi * r,
         3.0 * S + 2.0 * math.pi * r, P]
KINDS = ["L", "A+", "L", "A-", "L"]      # straight / +X end / straight / -X end


def segment_of(k):
    """(start, end, kind) of the stadium segment holding k in [0, P);
    zero-length segments (LENGTH == WIDTH) are skipped."""
    for i in range(5):
        if k < KNOTS[i + 1] - 1e-9:
            return KNOTS[i], KNOTS[i + 1], KINDS[i]
    return KNOTS[4], KNOTS[5], KINDS[4]


def path_point(u):
    x, y, _, _ = stadium_xy(u)
    o = off_of(u)
    if o:
        # moving toward the centre segment keeps the same inward direction, so
        # the offset curve is just the same stadium at a smaller radius
        nx, ny = inward_dir(x, y)
        x, y = x + nx * o, y + ny * o
    return V(x, y, z_of(u))


def path_edge(u1, u2):
    """one exact edge of the centre-line; u1..u2 must stay inside one segment"""
    z1, z2 = z_of(u1), z_of(u2)
    lo, _, kind = segment_of(0.5 * (u1 + u2) % P)
    if off_of(u1) > 1e-9 or off_of(u2) > 1e-9:
        # face run: the radius shrinks as we go, so this is neither a helix nor
        # a straight line. The pieces are short (cut at SAMPLE_STEP), so fit an
        # arc through three points and fall back to a chord if they are collinear.
        a, b = path_point(u1), path_point(u2)
        try:
            return Part.Arc(a, path_point(0.5 * (u1 + u2)), b).toShape()
        except Exception:
            return Part.LineSegment(a, b).toShape()
    if kind == "L":
        return Part.LineSegment(path_point(u1), path_point(u2)).toShape()
    cx = S if kind == "A+" else -S
    th0 = (-math.pi / 2 if kind == "A+" else math.pi / 2) + (u1 % P - lo) / r
    dth = (u2 - u1) / r
    dz = z2 - z1
    if abs(dz) < 1e-7:                      # flat -> plain circular arc
        p = [V(cx + r * math.cos(th0 + dth * f),
               r * math.sin(th0 + dth * f), z1) for f in (0.0, 0.5, 1.0)]
        return Part.Arc(*p).toShape()
    e = Part.makeHelix(2.0 * math.pi * dz / dth, dz, r).Edges[0]
    e.rotate(V(0, 0, 0), V(0, 0, 1), math.degrees(th0))
    e.translate(V(cx, 0, z1))
    return e


def split_u(ua, ub, step):
    """u values from ua to ub, cut at every stadium knot; with step given the
    pieces are additionally capped at that length (needed on the ramps, where
    z is not linear in u, so one piece = one constant-pitch helix)."""
    cuts = set([ua, ub])
    t = int(math.floor(ua / P))
    while t * P < ub:
        for k in KNOTS:
            if ua + 1e-7 < t * P + k < ub - 1e-7:
                cuts.add(t * P + k)
        t += 1
    cuts = sorted(cuts)
    if not step:
        return cuts
    out = []
    for a, b in zip(cuts, cuts[1:]):
        m = max(1, int(math.ceil((b - a) / step)))
        out += [a + (b - a) * j / m for j in range(m)]
    out.append(cuts[-1])
    return out


def centre_line():
    us = (split_u(u_face_bot_end, 0.0, SAMPLE_STEP)[:-1]
          + split_u(0.0, u_end, None)[:-1]
          + split_u(u_end, u_face_top_start, SAMPLE_STEP))
    edges = [path_edge(us[i], us[i + 1]) for i in range(len(us) - 1)
             if us[i + 1] - us[i] > 1e-7]
    return Part.Wire(edges)


def sweep_circle(spine):
    """circle of radius R swept along the spine, as a solid"""
    e0 = spine.OrderedEdges[0]
    prof = Part.Wire(Part.Circle(e0.valueAt(e0.FirstParameter),
                                 e0.tangentAt(e0.FirstParameter), R).toShape())
    try:
        sol = spine.makePipeShell([prof], True, False)
        if sol.isValid() and sol.Volume > 0:
            return sol
        warn("sweep result invalid, falling back to per-edge sweep")
    except Exception as e:
        warn("single sweep failed (%s), falling back to per-edge sweep" % e)
    parts = []
    for e in spine.OrderedEdges:
        p = e.valueAt(e.FirstParameter)
        pr = Part.Wire(Part.Circle(p, e.tangentAt(e.FirstParameter), R).toShape())
        parts.append(Part.Wire([e]).makePipeShell([pr], True, False))
        parts.append(Part.makeSphere(R, p))
    last = spine.OrderedEdges[-1]
    parts.append(Part.makeSphere(R, last.valueAt(last.LastParameter)))
    return parts[0].fuse(parts[1:])


def face_slot(ua, ub, zc, top):
    """The face run, as one prismatic channel following the path.

    The swept tube stops where the ramp reaches the face; from there the groove
    is a plain straight-sided channel cut in from the face, which is what the
    cable needs anyway and what a wound cable's last turn looks like. Keeping
    the two apart matters: when the tube ran alongside the slot for the whole
    run their surfaces were tangent, and the kernel answered that with a bigger
    volume than it started with and a sealed void inside the part.

    The channel is a hair oversize (SLOT_EPS) and overlaps the end of the tube,
    so at the junction the tube is strictly inside it - a clean crossing rather
    than a tangency. It is built in overlapping chunks and fused, because as a
    single polygon the ribbon self-intersects once the run laps over itself.
    """
    hw = R + SLOT_EPS
    lo = (zc - R - SLOT_EPS) if top else -1.0
    hi = (H + 1.0) if top else (zc + R + SLOT_EPS)
    n = max(12, int(math.ceil(abs(ub - ua) / 1.5)))
    pts = []
    for i in range(n + 1):
        q = path_point(ua + (ub - ua) * i / n)
        nx, ny = inward_dir(q.x, q.y)
        pts.append((V(q.x + nx * hw, q.y + ny * hw, lo),
                    V(q.x - nx * hw, q.y - ny * hw, lo)))
    up = V(0, 0, hi - lo)
    parts, step = [], 24
    for i in range(0, n, step):
        seg = pts[i:min(i + step + 2, n + 1)]     # one sample of overlap
        if len(seg) < 2:
            continue
        ring = [q[1] for q in seg] + [q[0] for q in reversed(seg)]
        parts.append(Part.Face(Part.makePolygon(ring + [ring[0]])).extrude(up))
    return parts[0] if len(parts) == 1 else parts[0].fuse(parts[1:])


# ---------------------------------------------------------------- body
def make_body():
    hw = WIDTH / 2.0
    if S < 1e-6:
        body = Part.makeCylinder(hw, H)
    else:
        p1, p2 = V(-S, -hw, 0), V(S, -hw, 0)
        p3, p4 = V(S, hw, 0), V(-S, hw, 0)
        edges = [
            Part.LineSegment(p1, p2).toShape(),
            Part.Arc(p2, V(S + hw, 0, 0), p3).toShape(),
            Part.LineSegment(p3, p4).toShape(),
            Part.Arc(p4, V(-S - hw, 0, 0), p1).toShape(),
        ]
        body = Part.Face(Part.Wire(edges)).extrude(V(0, 0, H))
    if EDGE_FILLET > 0:
        fe = [e for e in body.Edges
              if all(abs(v.Z) < 1e-6 or abs(v.Z - H) < 1e-6 for v in e.Vertexes)
              and abs(e.Vertexes[0].Z - e.Vertexes[-1].Z) < 1e-6]
        try:
            body = body.makeFillet(EDGE_FILLET, fe)
        except Exception as e:
            warn("fillet skipped: %s" % e)
    return body


# ---------------------------------------------------------------- build
doc = App.ActiveDocument or App.newDocument("CableSpool")

spine = centre_line()
log("sweeping groove (%d edges, %.0f mm centre-line) ..."
    % (len(spine.Edges), spine.Length))
groove = sweep_circle(spine)

anchor_bot = V(path_point(u_face_bot).x, path_point(u_face_bot).y, 0.0)
anchor_top = V(path_point(u_face_top).x, path_point(u_face_top).y, H)
slots = []
if face_run > 0:
    lap = min(2.0 * SAMPLE_STEP, RAMP_LENGTH * 0.5)
    slots = [face_slot(u_face_bot, u_face_bot_end + lap, zb, False),
             face_slot(u_face_top_start - lap, u_face_top, zt, True)]

log("boolean cut ...")
# Cut sequentially (groove, then channels). Fusing all tools first, or cutting
# them in one multi-tool call, tends to yield an invalid/split result because
# the groove and channel shapes touch each other near the ramps; one cut at a
# time keeps every intermediate result a single valid solid.
# One tool at a time: fusing them all first, or passing them as one multi-tool
# cut, gives an invalid or split result where the tools touch.
spool = make_body().cut(groove)
for slot in slots:
    spool = spool.cut(slot)
try:
    # .copy() matters: removeSplitter damages the shape it is called on even
    # when its return value is thrown away, so refining in place would leave us
    # with the broken solid we are trying to reject.
    refined = spool.copy().removeSplitter()
    if refined.isValid() and len(refined.Solids) == len(spool.Solids):
        spool = refined
    else:
        warn("removeSplitter would have invalidated the shape - kept unrefined")
except Exception:
    pass
if not spool.isValid():
    warn("result shape reports invalid - try a smaller SAMPLE_STEP")

base = doc.addObject("Part::Feature", "CableSpool_Base")
base.Shape = spool

sp = doc.addObject("Part::Feature", "SpiralPath")
sp.Shape = spine
try:
    sp.ViewObject.Visibility = False
except Exception:
    pass

for name, p in (("Anchor_Bottom", anchor_bot), ("Anchor_Top", anchor_top)):
    a = doc.addObject("Part::Feature", name)
    a.Shape = Part.Vertex(p)
    try:
        a.ViewObject.PointSize = 8
        a.ViewObject.PointColor = (1.0, 0.0, 0.0)
    except Exception:
        pass

try:
    body = doc.addObject("PartDesign::Body", "CableSpool")
    body.BaseFeature = base
except Exception as e:
    warn("could not create PartDesign Body (%s); use CableSpool_Base" % e)

doc.recompute()
try:
    import FreeCADGui
    FreeCADGui.SendMsgToActiveView("ViewFit")
except Exception:
    pass

log("DONE  size %.1f x %.1f x %.1f mm" % (LENGTH, WIDTH, H))
log("groove Ø%.2f, centre radius %.2f, turns %.2f, pitch %.2f"
    % (d, r, turns, pitch))
# What you actually see on the outside: with GROOVE_DEPTH_FAC > 0.5 the groove
# is undercut, so its opening is narrower than Ø d and the rib between turns
# looks wider than MIN_WALL (MIN_WALL is the real minimum, below the surface).
open_w = 2.0 * math.sqrt(max(R * R - (depth - R) ** 2, 0.0))
log("surface opening %.2f mm, visible rib %.2f mm (true min wall %.2f mm)"
    % (open_w, pitch - open_w, MIN_WALL))
if pitch - open_w > 1.6 * MIN_WALL:
    log("   -> lower GROOVE_DEPTH_FAC (now %.2f) for a wider opening / "
        "tighter looking coils" % GROOVE_DEPTH_FAC)
log("face run %.2f lap (%.0f mm), tightening %.1f mm inward to %.1f mm "
    "from the axis" % (FACE_TURN, face_len, face_inset, r - face_inset))
log("spiral cable %.0f mm + 2 x %.0f mm (ramp+face run+pocket) = %.0f mm"
    % (L_spiral, per_end, CABLE_LENGTH))
log("pocket anchors: bottom (%.1f, %.1f, 0)  top (%.1f, %.1f, %.1f)"
    % (anchor_bot.x, anchor_bot.y, anchor_top.x, anchor_top.y, H))
log("-> sketch your connector pocket on each face starting at the anchor, "
    "leaving about %.0f mm of cable+connector inside it" % CONNECTOR_ALLOWANCE)
